-- JetUI.lua
local Library = {}

-- Function to create a ScreenGui
function Library:CreateScreenGui()
    local Options = Instance.new("ScreenGui")
    Options.Name = "Options"
    Options.Parent = game.Players.LocalPlayer:WaitForChild("PlayerGui")
    Options.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    return Options
end

-- Function to create the Main Frame with a Draggable Header
function Library:CreateMainFrame(parent, position, size, title)
    local Frame = Instance.new("Frame")
    Frame.Parent = parent
    Frame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Frame.BorderSizePixel = 0
    Frame.Position = position or UDim2.new(0.5, -200, 0.5, -150)
    Frame.Size = size or UDim2.new(0, 400, 0, 300)

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 10)
    UICorner.Parent = Frame

    -- Create a Header for Dragging
    local Header = Instance.new("Frame")
    Header.Parent = Frame
    Header.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    Header.Size = UDim2.new(1, 0, 0, 30)
    Header.Name = "Header"

    local HeaderText = Instance.new("TextLabel")
    HeaderText.Parent = Header
    HeaderText.BackgroundTransparency = 1
    HeaderText.Size = UDim2.new(1, 0, 1, 0)
    HeaderText.Font = Enum.Font.SourceSansBold
    HeaderText.Text = title or "Main Frame"
    HeaderText.TextColor3 = Color3.fromRGB(255, 255, 255)
    HeaderText.TextSize = 18
    HeaderText.TextXAlignment = Enum.TextXAlignment.Center

    -- Enable Dragging via Header
    local UserInputService = game:GetService("UserInputService")
    local dragging = false
    local dragInput, dragStart, startPos

    local function update(input)
        local delta = input.Position - dragStart
        Frame.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end

    Header.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            dragStart = input.Position
            startPos = Frame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    Header.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            update(input)
        end
    end)

    return Frame
end

-- Function to create a Search Bar
function Library:CreateSearchBar(parent, position, size)
    local SearchBar = Instance.new("TextBox")
    SearchBar.Parent = parent
    SearchBar.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    SearchBar.BorderSizePixel = 0
    SearchBar.Position = position or UDim2.new(0, 10, 0, 40)
    SearchBar.Size = size or UDim2.new(0, 380, 0, 30)
    SearchBar.Font = Enum.Font.SourceSans
    SearchBar.Text = "Search options..."
    SearchBar.TextColor3 = Color3.fromRGB(200, 200, 200)
    SearchBar.TextSize = 18
    SearchBar.TextXAlignment = Enum.TextXAlignment.Left

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 5)
    UICorner.Parent = SearchBar

    return SearchBar
end

-- Function to create an Item Button with text and icon
function Library:CreateItemButton(parent, text, subtext, iconAssetId, onClick)
    local ButtonFrame = Instance.new("Frame")
    ButtonFrame.Parent = parent
    ButtonFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    ButtonFrame.BorderSizePixel = 0
    ButtonFrame.Size = UDim2.new(1, -20, 0, 60)
    ButtonFrame.Position = UDim2.new(0, 10, 0, 80)

    local TextLabel = Instance.new("TextLabel")
    TextLabel.Parent = ButtonFrame
    TextLabel.BackgroundTransparency = 1
    TextLabel.Position = UDim2.new(0, 10, 0, 5)
    TextLabel.Size = UDim2.new(0, 250, 0, 20)
    TextLabel.Font = Enum.Font.SourceSansBold
    TextLabel.Text = text or "Button Text"
    TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TextLabel.TextSize = 16
    TextLabel.TextXAlignment = Enum.TextXAlignment.Left

    local SubTextLabel = Instance.new("TextLabel")
    SubTextLabel.Parent = ButtonFrame
    SubTextLabel.BackgroundTransparency = 1
    SubTextLabel.Position = UDim2.new(0, 10, 0, 30)
    SubTextLabel.Size = UDim2.new(0, 250, 0, 20)
    SubTextLabel.Font = Enum.Font.SourceSans
    SubTextLabel.Text = subtext or "Subtext"
    SubTextLabel.TextColor3 = Color3.fromRGB(180, 180, 180)
    SubTextLabel.TextSize = 14
    SubTextLabel.TextXAlignment = Enum.TextXAlignment.Left

    local Icon = Instance.new("ImageLabel")
    Icon.Parent = ButtonFrame
    Icon.BackgroundTransparency = 1
    Icon.Position = UDim2.new(1, -40, 0.2, 0)
    Icon.Size = UDim2.new(0, 24, 0, 24)
    Icon.Image = iconAssetId or "rbxassetid://your_default_icon"

    -- Button Click Event
    ButtonFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            if onClick then
                onClick()
            end
        end
    end)

    return ButtonFrame
end

-- Function to create a Toggle Switch
function Library:CreateToggle(parent, position, size, onToggle)
    local ToggleFrame = Instance.new("Frame")
    ToggleFrame.Parent = parent
    ToggleFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    ToggleFrame.Position = position
    ToggleFrame.Size = size

    local Toggle = Instance.new("Frame")
    Toggle.Parent = ToggleFrame
    Toggle.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Toggle.Size = UDim2.new(0, 40, 0, 22)
    Toggle.Position = UDim2.new(0, 0, 0, 0) -- Positioned on the left

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(1, 0)
    UICorner.Parent = Toggle

    local Circle = Instance.new("ImageLabel")
    Circle.Parent = Toggle
    Circle.Size = UDim2.new(0, 19, 0, 19)
    Circle.Position = UDim2.new(0, 1, 0.04, 0)
    Circle.Image = "rbxassetid://6755657357"

    local isOn = false
    ToggleFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            isOn = not isOn
            if isOn then
                Toggle:TweenPosition(UDim2.new(1, -40, 0, 0), "Out", "Quad", 0.2, true)
            else
                Toggle:TweenPosition(UDim2.new(0, 0, 0, 0), "Out", "Quad", 0.2, true)
            end
            if onToggle then
                onToggle(isOn)
            end
        end
    end)

    return ToggleFrame
end

-- Function to create a Slider
function Library:CreateSlider(parent, position, size, minValue, maxValue, onChange)
    local SliderFrame = Instance.new("Frame")
    SliderFrame.Parent = parent
    SliderFrame.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
    SliderFrame.Position = position
    SliderFrame.Size = size

    local SliderBar = Instance.new("Frame")
    SliderBar.Parent = SliderFrame
    SliderBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    SliderBar.Size = UDim2.new(0.5, 0, 0, 4)  -- Thin bar at the bottom
    SliderBar.Position = UDim2.new(0, 0, 1, -10) -- Positioned at the bottom

    local SliderKnob = Instance.new("Frame")
    SliderKnob.Parent = SliderFrame
    SliderKnob.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    SliderKnob.Size = UDim2.new(0, 10, 0, 20)
    SliderKnob.Position = UDim2.new(0.5, -5, 1, -25) -- Positioned above the bar
    SliderKnob.AnchorPoint = Vector2.new(0.5, 0.5)

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(1, 0)
    UICorner.Parent = SliderKnob

    local Dragging = false

    SliderKnob.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = true
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    Dragging = false
                end
            end)
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if Dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local SliderAbsolutePosition = SliderBar.AbsolutePosition
            local SliderAbsoluteSize = SliderBar.AbsoluteSize
            local relativeX = (input.Position.X - SliderAbsolutePosition.X) / SliderAbsoluteSize.X
            relativeX = math.clamp(relativeX, 0, 1)
            SliderBar.Size = UDim2.new(relativeX, 0, 0, 4)
            SliderKnob.Position = UDim2.new(relativeX, 0, 1, -25)
            if onChange then
                local value = math.floor(minValue + (maxValue - minValue) * relativeX)
                onChange(value)
            end
        end
    end)

    game:GetService("UserInputService").InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = false
        end
    end)

    return SliderFrame
end

return Library
